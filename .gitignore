REVIEW_FINDINGS.md

# Build artifacts of the cloud pipeline. Regenerated byte-for-byte from
# cloud_registry/courses/*.md by batch_pipeline.py, and published to GCS — the
# bucket is the distribution channel, not git. Tracking them means a binary diff
# on every embedding-model change.
cloud_registry/registry/

# Bundled ONNX embedding model cache (~240MB) — populated by
# scripts/fetch_embedding_model.py, shipped with the deployment, not with git.
models/

# Per-device state, not source. Shipping these in the repo means a fresh clone
# inherits another machine's course list and memory — local_manifest.json
# claimed 7 downloaded courses whose data did not exist.
app_local/storage/local_manifest.json
app_local/storage/embedding_stamp.json
app_local/memory/metadata_links.json
